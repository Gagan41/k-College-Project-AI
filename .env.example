# ==============================================================================
# SMART AI-BASED CCTV ATTENDANCE LEDGER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (Supabase PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Backend Server Configuration
ENVIRONMENT=development
API_V1_PREFIX=/api
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Security & Tokens
JWT_SECRET_KEY=generate_and_put_random_32_char_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REQUIRE_EMAIL_OTP=false

# Initial Administrator Bootstrap Credentials (Configured securely via environment)
ADMIN_BOOTSTRAP_EMAIL=admin@attendance.edu
ADMIN_BOOTSTRAP_PASSWORD=change_this_secure_admin_password
ADMIN_BOOTSTRAP_NAME="System Administrator"

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_APP_NAME="Smart CCTV Attendance Ledger"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Attendance Ledger System <your_email@gmail.com>"

